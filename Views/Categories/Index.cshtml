@{
    ViewData["Title"] = "Categories";
    var canManage = User.IsInRole("Administrator") || User.IsInRole("StoreManager");
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2>Categories</h2>
        <p class="text-muted mb-0">Organize medicines into categories such as Analgesics, Antibiotics, etc.</p>
    </div>

    @if (canManage)
    {
        <button type="button" class="btn btn-primary" id="btnAddCategory">
            <i class="fa-solid fa-plus"></i> Add Category
        </button>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            @if (canManage)
            {
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="chkShowDeleted">
                    <label class="form-check-label small" for="chkShowDeleted">Show deleted categories</label>
                </div>
            }
            else
            {
                <span></span>
            }
        </div>

        <table id="categoriesTable" class="table table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created</th>
                    @if (canManage)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<partial name="_CategoryModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.ptCanManageCategories = @Html.Raw(canManage.ToString().ToLower());
    </script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
}
