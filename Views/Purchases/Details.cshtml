@model PharmaTrackPro.Models.Purchase
@{
    ViewData["Title"] = $"Purchase #{Model.Id}";
    var canManage = User.IsInRole("Administrator") || User.IsInRole("StoreManager");

    var statusBadge = Model.Status switch
    {
        PharmaTrackPro.Models.Enums.PurchaseStatus.Pending => "bg-warning text-dark",
        PharmaTrackPro.Models.Enums.PurchaseStatus.Received => "bg-success",
        PharmaTrackPro.Models.Enums.PurchaseStatus.Cancelled => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2>Purchase Order #@Model.Id</h2>
        <p class="text-muted mb-0">
            @Model.Supplier?.Name &middot; @Model.PurchaseDate.ToString("MMM dd, yyyy")
            @if (!string.IsNullOrEmpty(Model.InvoiceNumber))
            {
                <text> &middot; Invoice @Model.InvoiceNumber</text>
            }
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i> Back to Purchases
    </a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <span class="badge @statusBadge fs-6">@Model.Status</span>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="text-muted small mt-2">@Model.Notes</div>
            }
        </div>

        @if (canManage && Model.Status == PharmaTrackPro.Models.Enums.PurchaseStatus.Pending)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success" id="btnReceive" data-id="@Model.Id">
                    <i class="fa-solid fa-truck-ramp-box"></i> Mark as Received
                </button>
                <button type="button" class="btn btn-outline-danger" id="btnCancel" data-id="@Model.Id">
                    <i class="fa-solid fa-ban"></i> Cancel Order
                </button>
            </div>
        }
        @if (canManage && Model.Status == PharmaTrackPro.Models.Enums.PurchaseStatus.Received)
        {
            <a asp-controller="PurchaseReturns" asp-action="Create" asp-route-purchaseId="@Model.Id" class="btn btn-outline-warning">
                <i class="fa-solid fa-rotate-left"></i> Create Return
            </a>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h6 class="mb-3">Line Items</h6>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th>Batch #</th>
                        <th>Expiry</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @item.Medicine?.Name
                                @if (!string.IsNullOrEmpty(item.Medicine?.Strength))
                                {
                                    <span class="text-muted"> (@item.Medicine.Strength)</span>
                                }
                            </td>
                            <td class="font-monospace small">@item.BatchNumber</td>
                            <td>@item.ExpiryDate.ToString("MMM yyyy")</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">@item.UnitCost.ToString("C")</td>
                            <td class="text-end fw-semibold">@item.Subtotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end fw-bold">Grand Total</td>
                        <td class="text-end fw-bold">@Model.TotalAmount.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@if (Model.Returns != null && Model.Returns.Any())
{
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body">
            <h6 class="mb-3">Returns Against This Purchase</h6>
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Reason</th>
                        <th class="text-end">Refund</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ret in Model.Returns.OrderByDescending(r => r.ReturnDate))
                    {
                        <tr>
                            <td>#@ret.Id</td>
                            <td>@ret.ReturnDate.ToString("MMM dd, yyyy")</td>
                            <td>@ret.Reason</td>
                            <td class="text-end">@ret.TotalRefundAmount.ToString("C")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="PurchaseReturns" asp-action="Details" asp-route-id="@ret.Id">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/purchases-details.js" asp-append-version="true"></script>
}
