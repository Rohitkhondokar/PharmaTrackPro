@model PharmaTrackPro.ViewModels.Purchase.PurchaseFormViewModel
@{
    ViewData["Title"] = "New Purchase Order";
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2>New Purchase Order</h2>
        <p class="text-muted mb-0">Record what you're ordering from a supplier. Stock is added once you mark it Received.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i> Back to Purchases
    </a>
</div>

<form id="purchaseForm" novalidate>
    @Html.AntiForgeryToken()

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="SupplierId" class="form-label">Supplier</label>
                    <select class="form-select" id="SupplierId" required>
                        <option value="">-- Select Supplier --</option>
                    </select>
                    <span class="text-danger small" id="SupplierIdError"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="InvoiceNumber" class="form-label">Invoice Number</label>
                    <input type="text" class="form-control" id="InvoiceNumber" maxlength="50" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="PurchaseDate" class="form-label">Purchase Date</label>
                    <input type="date" class="form-control" id="PurchaseDate" required />
                </div>
            </div>
            <div class="mb-1">
                <label for="Notes" class="form-label">Notes</label>
                <textarea class="form-control" id="Notes" rows="2" maxlength="500"></textarea>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="mb-0">Line Items</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddLine">
                    <i class="fa-solid fa-plus"></i> Add Line
                </button>
            </div>
            <span class="text-danger small" id="ItemsError"></span>

            <div class="table-responsive">
                <table class="table align-middle" id="lineItemsTable">
                    <thead>
                        <tr>
                            <th style="min-width: 220px;">Medicine</th>
                            <th style="width: 100px;">Qty</th>
                            <th style="width: 130px;">Unit Cost</th>
                            <th style="width: 140px;">Batch Number</th>
                            <th style="width: 160px;">Expiry Date</th>
                            <th style="width: 110px;">Subtotal</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="lineItemsBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body d-flex justify-content-end align-items-center">
            <div class="text-end">
                <div class="text-muted small">Grand Total</div>
                <div class="fs-4 fw-bold" id="grandTotal">$0.00</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" id="btnSavePurchase">
            <i class="fa-solid fa-floppy-disk"></i> Save Purchase Order
        </button>
    </div>
</form>

<!-- Row template (cloned by JS, never displayed directly) -->
<template id="lineItemTemplate">
    <tr class="line-item-row">
        <td>
            <select class="form-select form-select-sm medicine-select" required>
                <option value="">-- Select Medicine --</option>
            </select>
        </td>
        <td><input type="number" class="form-control form-control-sm qty-input" min="1" value="1" required /></td>
        <td><input type="number" class="form-control form-control-sm cost-input" min="0" step="0.01" required /></td>
        <td><input type="text" class="form-control form-control-sm batch-input" maxlength="50" required /></td>
        <td><input type="date" class="form-control form-control-sm expiry-input" required /></td>
        <td class="subtotal-cell text-end fw-semibold">$0.00</td>
        <td class="text-center">
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-line">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    <script src="~/js/purchases-create.js" asp-append-version="true"></script>
}
