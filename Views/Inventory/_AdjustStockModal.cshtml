<div class="modal fade" id="adjustModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="adjustForm" novalidate>
                <input type="hidden" id="AdjustBatchId" />

                <div class="modal-header">
                    <h5 class="modal-title">Adjust Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <p class="text-muted small mb-3" id="adjustBatchInfo"></p>

                    <div class="mb-3">
                        <label for="AdjustNewQuantity" class="form-label">New Quantity</label>
                        <input type="number" class="form-control" id="AdjustNewQuantity" min="0" required />
                        <span class="text-danger small" id="AdjustNewQuantityError"></span>
                    </div>

                    <div class="mb-3">
                        <label for="AdjustReason" class="form-label">Reason</label>
                        <textarea class="form-control" id="AdjustReason" rows="2" maxlength="300" placeholder="e.g. Damaged during handling, recount correction" required></textarea>
                        <span class="text-danger small" id="AdjustReasonError"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveAdjustment">
                        <i class="fa-solid fa-floppy-disk"></i> Save Adjustment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
