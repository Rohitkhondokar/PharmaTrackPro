@{
    ViewData["Title"] = "Sales History";
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2>Sales History</h2>
        <p class="text-muted mb-0">All completed point-of-sale transactions.</p>
    </div>
    <a asp-action="Index" class="btn btn-primary">
        <i class="fa-solid fa-cash-register"></i> New Sale
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table id="salesTable" class="table table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Cashier</th>
                    <th>Date</th>
                    <th>Payment</th>
                    <th>Items</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales-history.js" asp-append-version="true"></script>
}
