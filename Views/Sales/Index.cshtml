@{
    ViewData["Title"] = "Point of Sale";
}

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

<div class="page-header">
    <h2>Point of Sale</h2>
    <p class="text-muted mb-0">Search for a medicine, build the cart, then check out.</p>
</div>

<div class="row g-3">
    <!-- Search & results -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <label for="medicineSearch" class="form-label">Search Medicines</label>
                <input type="text" class="form-control" id="medicineSearch" placeholder="Type a medicine name..." autocomplete="off" />
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="searchResults" class="list-group list-group-flush" style="max-height: 480px; overflow-y: auto;">
                    <div class="text-center text-muted py-4">Start typing to search medicines.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cart & checkout -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="mb-3">
                    <label for="CustomerId" class="form-label">Customer</label>
                    <select class="form-select" id="CustomerId">
                        <option value="">Walk-in Customer</option>
                    </select>
                </div>
                <div class="mb-1">
                    <label for="PaymentMethod" class="form-label">Payment Method</label>
                    <select class="form-select" id="PaymentMethod">
                        <option value="Cash">Cash</option>
                        <option value="Card">Card</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="mb-3">Cart</h6>

                <div id="emptyCartMessage" class="text-center text-muted py-4">Cart is empty. Search and add medicines to begin.</div>

                <table class="table align-middle d-none" id="cartTable">
                    <thead>
                        <tr>
                            <th>Medicine</th>
                            <th style="width: 90px;">Qty</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="cartBody"></tbody>
                </table>

                <div id="rxWarning" class="alert alert-warning d-none">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="PrescriptionVerified">
                        <label class="form-check-label" for="PrescriptionVerified">
                            <i class="fa-solid fa-file-prescription"></i> This sale includes prescription-only item(s). I have verified the prescription.
                        </label>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2">
                    <span class="text-muted">Grand Total</span>
                    <span class="fs-4 fw-bold" id="grandTotal">$0.00</span>
                </div>

                <button type="button" class="btn btn-primary w-100 mt-3" id="btnCheckout" disabled>
                    <i class="fa-solid fa-cash-register"></i> Complete Sale
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pos.js" asp-append-version="true"></script>
}
