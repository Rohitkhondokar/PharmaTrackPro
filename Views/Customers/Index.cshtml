@{
    ViewData["Title"] = "Customers";
    var canManage = User.IsInRole("Administrator") || User.IsInRole("StoreManager") || User.IsInRole("Cashier") || User.IsInRole("Pharmacist");
    var canDelete = User.IsInRole("Administrator") || User.IsInRole("StoreManager");
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2>Customers</h2>
        <p class="text-muted mb-0">People who buy from the pharmacy.</p>
    </div>

    @if (canManage)
    {
        <button type="button" class="btn btn-primary" id="btnAddCustomer">
            <i class="fa-solid fa-plus"></i> Add Customer
        </button>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            @if (canDelete)
            {
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="chkShowDeleted">
                    <label class="form-check-label small" for="chkShowDeleted">Show deleted customers</label>
                </div>
            }
            else
            {
                <span></span>
            }
        </div>

        <table id="customersTable" class="table table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Date of Birth</th>
                    <th>Status</th>
                    @if (canManage)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<partial name="_CustomerModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.ptCanManageCustomers = @Html.Raw(canManage.ToString().ToLower());
        window.ptCanDeleteCustomers = @Html.Raw(canDelete.ToString().ToLower());
    </script>
    <script src="~/js/customers.js" asp-append-version="true"></script>
}
