@{
    ViewData["Title"] = "Sale Returns";
}

<div class="page-header">
    <h2>Sale Returns</h2>
    <p class="text-muted mb-0">Medicine returned by customers from completed sales.</p>
</div>

<div class="alert alert-info">
    <i class="fa-solid fa-circle-info"></i>
    Returns are created from a specific sale's Details page (look for the <strong>Create Return</strong> button).
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table id="saleReturnsTable" class="table table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Sale</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Reason</th>
                    <th>Items</th>
                    <th>Refund Amount</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/sale-returns-index.js" asp-append-version="true"></script>
}
