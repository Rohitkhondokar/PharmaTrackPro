@model PharmaTrackPro.Models.SaleReturn
@{
    ViewData["Title"] = $"Return #{Model.Id}";
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2>Sale Return #@Model.Id</h2>
        <p class="text-muted mb-0">
            Against <a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.SaleId">Sale #@Model.SaleId</a>
            &middot; @(Model.Sale?.Customer?.Name ?? "Walk-in") &middot; @Model.ReturnDate.ToString("MMM dd, yyyy")
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i> Back to Returns
    </a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="text-muted small">Reason</div>
        <div>@Model.Reason</div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h6 class="mb-3">Returned Items</h6>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th class="text-end">Qty Returned</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Refund</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.SaleItem?.Medicine?.Name</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                            <td class="text-end fw-semibold">@item.Subtotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Total Refund</td>
                        <td class="text-end fw-bold">@Model.TotalRefundAmount.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
