@model PharmaTrackPro.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h2>Dashboard</h2>
    <p class="text-muted mb-0">Welcome back, @User.Identity!.Name.</p>
</div>

<div class="row g-3 mb-1">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-primary-soft text-primary"><i class="fa-solid fa-pills"></i></div>
            <div>
                <div class="stat-value">@Model.TotalMedicines</div>
                <div class="stat-label">Active Medicines</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-warning-soft text-warning"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div>
                <div class="stat-value">@Model.LowStockCount</div>
                <div class="stat-label">Low Stock</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-danger-soft text-danger"><i class="fa-solid fa-hourglass-end"></i></div>
            <div>
                <div class="stat-value">@Model.ExpiredCount</div>
                <div class="stat-label">Expired Batches</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-success-soft text-success"><i class="fa-solid fa-sack-dollar"></i></div>
            <div>
                <div class="stat-value">@Model.TotalInventoryValue.ToString("C0")</div>
                <div class="stat-label">Inventory Value</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon bg-warning-soft text-warning"><i class="fa-solid fa-clock"></i></div>
            <div>
                <div class="stat-value">@Model.NearExpiryCount</div>
                <div class="stat-label">Near Expiry Batches</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon bg-primary-soft text-primary"><i class="fa-solid fa-cart-shopping"></i></div>
            <div>
                <div class="stat-value">@Model.PendingPurchasesCount</div>
                <div class="stat-label">Pending Purchase Orders</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="mb-3">Purchase Spend — Last 6 Months</h6>
                <canvas id="spendChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="mb-3">Stock by Category</h6>
                <canvas id="categoryChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1 mb-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="mb-0">Recent Purchases</h6>
                    <a asp-controller="Purchases" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                @if (Model.RecentPurchases.Any())
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Supplier</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.RecentPurchases)
                            {
                                <tr>
                                    <td><a asp-controller="Purchases" asp-action="Details" asp-route-id="@p.Id">#@p.Id</a></td>
                                    <td>@p.SupplierName</td>
                                    <td>@p.PurchaseDate.ToString("MMM dd, yyyy")</td>
                                    <td>@p.Status</td>
                                    <td class="text-end">@p.TotalAmount.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">No purchases recorded yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const spendLabels = @Html.Raw(Json.Serialize(Model.MonthlyPurchaseSpend.Select(m => m.MonthLabel)));
        const spendData = @Html.Raw(Json.Serialize(Model.MonthlyPurchaseSpend.Select(m => m.Total)));
        const categoryLabels = @Html.Raw(Json.Serialize(Model.StockByCategory.Select(c => c.CategoryName)));
        const categoryData = @Html.Raw(Json.Serialize(Model.StockByCategory.Select(c => c.TotalQuantity)));

        new Chart(document.getElementById('spendChart'), {
            type: 'bar',
            data: {
                labels: spendLabels,
                datasets: [{
                    label: 'Purchase Spend',
                    data: spendData,
                    backgroundColor: '#0d6efd'
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: categoryLabels,
                datasets: [{
                    data: categoryData,
                    backgroundColor: ['#0d6efd', '#20c997', '#ffc107', '#fd7e14', '#dc3545', '#6f42c1', '#0dcaf0', '#6c757d']
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}
