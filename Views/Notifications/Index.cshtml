@{
    ViewData["Title"] = "Notifications";
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2>Notifications</h2>
        <p class="text-muted mb-0">Low stock, expiry, and pending purchase alerts.</p>
    </div>
    <button type="button" class="btn btn-outline-secondary" id="btnMarkAllReadPage">
        <i class="fa-solid fa-check-double"></i> Mark All as Read
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div id="fullNotificationList">
            <div class="text-center text-muted py-4">Loading...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script>
        $(function () {
            loadFullNotificationList();

            $("#btnMarkAllReadPage").on("click", function () {
                markAllNotificationsRead(function () {
                    loadFullNotificationList();
                });
            });
        });
    </script>
}
