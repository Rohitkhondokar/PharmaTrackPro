@model PharmaTrackPro.ViewModels.Medicine.MedicineFormViewModel
@using PharmaTrackPro.Models.Enums

<div class="modal fade" id="medicineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="medicineForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="Id" name="Id" value="0" />

                <div class="modal-header">
                    <h5 class="modal-title" id="medicineModalTitle">Add Medicine</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="Name" class="form-label">Medicine Name</label>
                            <input type="text" class="form-control" id="Name" name="Name" maxlength="150" required />
                            <span class="text-danger small" id="NameError"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="Strength" class="form-label">Strength</label>
                            <input type="text" class="form-control" id="Strength" name="Strength" maxlength="30" placeholder="e.g. 500mg" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="GenericName" class="form-label">Generic Name</label>
                        <input type="text" class="form-control" id="GenericName" name="GenericName" maxlength="150" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="CategoryId" class="form-label">Category</label>
                            <select class="form-select" id="CategoryId" name="CategoryId" required>
                                <option value="">-- Select Category --</option>
                            </select>
                            <span class="text-danger small" id="CategoryIdError"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="ManufacturerId" class="form-label">Manufacturer</label>
                            <select class="form-select" id="ManufacturerId" name="ManufacturerId" required>
                                <option value="">-- Select Manufacturer --</option>
                            </select>
                            <span class="text-danger small" id="ManufacturerIdError"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="UnitOfMeasure" class="form-label">Unit of Measure</label>
                            <select class="form-select" id="UnitOfMeasure" name="UnitOfMeasure">
                                @foreach (var unit in Enum.GetValues(typeof(UnitOfMeasure)).Cast<UnitOfMeasure>())
                                {
                                    <option value="@((int)unit)">@unit</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="PurchasePrice" class="form-label">Purchase Price</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="PurchasePrice" name="PurchasePrice" required />
                            <span class="text-danger small" id="PurchasePriceError"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="SellingPrice" class="form-label">Selling Price</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="SellingPrice" name="SellingPrice" required />
                            <span class="text-danger small" id="SellingPriceError"></span>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" class="form-check-input" id="RequiresPrescription" name="RequiresPrescription" />
                        <label class="form-check-label" for="RequiresPrescription">Requires Prescription</label>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" checked />
                        <label class="form-check-label" for="IsActive">Active</label>
                    </div>

                    <hr />

                    <div class="row align-items-center">
                        <div class="col-md-8 mb-3">
                            <label for="ImageFile" class="form-label">Photo (optional, max 2MB — JPG/PNG/WEBP)</label>
                            <input type="file" class="form-control" id="ImageFile" accept="image/jpeg,image/png,image/webp" />
                            <span class="text-danger small" id="ImageFileError"></span>
                        </div>
                        <div class="col-md-4 mb-3 text-center">
                            <img id="imagePreview" src="" alt="" class="img-thumbnail d-none" style="max-height: 90px;" />
                        </div>
                    </div>

                    <div id="barcodeSection" class="d-none border rounded p-2 text-center bg-light">
                        <div class="small text-muted mb-1">Barcode &amp; QR (auto-generated, assigned once)</div>
                        <img id="barcodePreview" src="" alt="Barcode" style="max-height: 60px;" class="me-3" />
                        <img id="qrPreview" src="" alt="QR Code" style="max-height: 60px;" />
                        <div class="small font-monospace mt-1" id="barcodeValueText"></div>
                        <a href="#" target="_blank" id="btnPrintLabel" class="btn btn-sm btn-outline-secondary mt-2">
                            <i class="fa-solid fa-print"></i> Print Label
                        </a>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveMedicine">
                        <i class="fa-solid fa-floppy-disk"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
