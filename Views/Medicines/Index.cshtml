@{
    ViewData["Title"] = "Medicines";
    var canEdit = User.IsInRole("Administrator") || User.IsInRole("StoreManager") || User.IsInRole("Pharmacist");
    var canDelete = User.IsInRole("Administrator") || User.IsInRole("StoreManager");
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h2>Medicines</h2>
        <p class="text-muted mb-0">The medicine catalog — pricing, category, and manufacturer details.</p>
    </div>

    @if (canEdit)
    {
        <button type="button" class="btn btn-primary" id="btnAddMedicine">
            <i class="fa-solid fa-plus"></i> Add Medicine
        </button>
    }
</div>

<div class="alert alert-info">
    <i class="fa-solid fa-circle-info"></i>
    Batch-level stock quantities and expiry dates are tracked separately in the upcoming
    <strong>Batch &amp; Inventory Management</strong> module — this catalog defines what a medicine <em>is</em>, not how much of it you currently have.
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            @if (canDelete)
            {
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="chkShowDeleted">
                    <label class="form-check-label small" for="chkShowDeleted">Show deleted medicines</label>
                </div>
            }
            else
            {
                <span></span>
            }
        </div>

        <table id="medicinesTable" class="table table-hover align-middle w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Strength</th>
                    <th>Unit</th>
                    <th>Category</th>
                    <th>Manufacturer</th>
                    <th>Purchase Price</th>
                    <th>Selling Price</th>
                    <th>Rx</th>
                    <th>Status</th>
                    @if (canEdit)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<partial name="_MedicineModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.ptCanEditMedicines = @Html.Raw(canEdit.ToString().ToLower());
        window.ptCanDeleteMedicines = @Html.Raw(canDelete.ToString().ToLower());
    </script>
    <script src="~/js/medicines.js" asp-append-version="true"></script>
}
